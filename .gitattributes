# ============================================================
#  换行符策略：源码统一 LF，Windows 脚本保持 CRLF
#  目的：避免 Windows 开发 / Linux 部署之间产生整文件 diff
# ============================================================

# 默认：文本文件在仓库里与工作区里都统一为 LF
# （跨 Windows 开发 / Linux 部署，避免整文件 diff）
* text=auto eol=lf

# ---------- 源码：LF ----------
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.astro         text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.svg           text eol=lf
*.conf          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# ---------- Windows 脚本：CRLF ----------
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ---------- 二进制：不做换行符处理 ----------
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp3   binary
*.wav   binary
*.m4a   binary
*.ogg   binary
*.flac  binary
*.zip   binary
*.7z    binary

# ---------- 语言统计：把生成产物排除在 GitHub 语言统计外 ----------
dist/**     linguist-generated=true
pnpm-lock.yaml linguist-generated=true
