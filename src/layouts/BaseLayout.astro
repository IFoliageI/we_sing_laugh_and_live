---
import '../styles/global.css';
import { site, sideLinks, friendLinks } from '../data/site';
import { imageUrl } from '../lib/media';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ?? site.title;
const pageDesc = description ?? site.description;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={site.keywords} />
    <meta name="theme-color" content={site.themeColor} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    {site.socialImage && <meta property="og:image" content={imageUrl(site.socialImage)} />}
    <script is:inline>
    // 彩蛋：刷新（reload）即清空彩蛋状态，实现“一刷新重新隐藏”；普通跨页跳转不触发。
    (function () {
      try {
        var mode = localStorage.getItem('lmy-theme-mode');
        document.documentElement.classList.toggle('dark',
          mode === 'dark' || (mode !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches));
      } catch (e) {
        document.documentElement.classList.toggle('dark', window.matchMedia('(prefers-color-scheme: dark)').matches);
      }
      try {
        var nav = performance.getEntriesByType('navigation');
        if (nav.length && nav[0].type === 'reload') {
          sessionStorage.removeItem('lmy-easter-unlock');
          sessionStorage.removeItem('lmy-past');
        }
      } catch (e) {}
    })();
    </script>
  </head>
  <body>
    <div class="app">
      <header class="app-header">
        <button type="button" class="icon-btn sficon" id="drawer-open" aria-label="打开菜单" title="打开菜单" aria-expanded="false" aria-controls="drawer">&#xE700;</button>
        <div class="app-header__brand">
          <img class="app-header__logo" src={imageUrl(site.logoImage)} alt="临小渺" />
          <a class="app-header__title" href="/">{site.brandTitle}</a>
        </div>
        <span class="app-header__spacer"></span>
        <div class="theme-toggle-wrap">
          <button type="button" class="icon-btn sficon" id="theme-toggle" aria-label="切换主题模式" title="切换主题模式" aria-haspopup="menu" aria-expanded="false" aria-controls="theme-menu">&#xE770;</button>
          <div class="theme-menu" id="theme-menu" role="menu" inert>
            <button type="button" class="theme-menu__item" data-mode="light" role="menuitemradio" aria-checked="false">
              <span class="ti sficon">&#xE706;</span><span>日间模式</span><span class="theme-menu__check sficon" data-check="light"></span>
            </button>
            <button type="button" class="theme-menu__item" data-mode="dark" role="menuitemradio" aria-checked="false">
              <span class="ti sficon">&#xEC46;</span><span>夜间模式</span><span class="theme-menu__check sficon" data-check="dark"></span>
            </button>
            <button type="button" class="theme-menu__item" data-mode="system" role="menuitemradio" aria-checked="false">
              <span class="ti sficon">&#xE770;</span><span>随系统切换</span><span class="theme-menu__check sficon" data-check="system"></span>
            </button>
          </div>
        </div>
      </header>

      <!-- 侧边抽屉 -->
      <div class="drawer-overlay" id="drawer-overlay" aria-hidden="true"></div>
      <aside class="drawer" id="drawer" role="dialog" aria-label="网站导航" aria-modal="true" aria-hidden="true" inert>
        <div class="drawer__head">
          <div class="drawer__brand">
            <span>这只是一个侧边栏咕</span>
          </div>
          <button type="button" class="icon-btn sficon" id="drawer-close" aria-label="关闭菜单" title="关闭菜单">&#xE711;</button>
        </div>

        <div class="drawer__label">导航</div>
        <nav>
          <a class="drawer__item" href="/">
            <span class="emoji sficon">&#xE80F;</span><span>渺の怪动静</span>
          </a>
          <a class="drawer__item" href="/request/">
            <span class="emoji sficon">&#xE8D6;</span><span>渺の歌单</span>
          </a>          
          <a class="drawer__item" href="/about/">
            <span class="emoji sficon">&#xE946;</span><span>关于</span>
          </a>
        </nav>

        <div class="drawer__divider"></div>
        <div class="drawer__label">关注老大谢谢咕</div>
        <nav>
          {
            sideLinks.map((l) => (
              <a class="drawer__item" href={l.url} target="_blank" rel="noopener">
                <img class="drawer__link-icon" src={imageUrl(l.icon)} alt="" width="20" height="20" /><span>{l.title}</span>
              </a>
            ))
          }
        </nav>

        {friendLinks.length > 0 && (
          <>
            <div class="drawer__divider"></div>
            <div class="drawer__label">以下是一些友链咕</div>
            <nav>
              {friendLinks.map((l) => (
                <a class="drawer__item" href={l.url} target="_blank" rel="noopener">
                  <img class="drawer__link-icon" src={imageUrl(l.icon)} alt="" width="20" height="20" /><span>{l.title}</span>
                </a>
              ))}
            </nav>
          </>
        )}
      </aside>


      <main class="app-main">
        <slot />
      </main>

      <footer class="app-footer">
        <span>©</span><span>{site.footer.content}</span>
      </footer>
    </div>

    <script>
      import '../scripts/layout';
    </script>
  </body>
</html>
